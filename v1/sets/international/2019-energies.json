      },
      {
        "title": "Bulbapedia: Basic Fairy Energy (TCG) (Wayback Machine copy, 14 August 2026)",
        "url": "https://web.archive.org/web/20260814035617/https://bulbapedia.bulbagarden.net/wiki/Fairy_Energy_(TCG)"
      },
      {
