{
  "id": "english/vs-tropical-mega-battle",
  "catalog": "english",
  "name": "VS Tropical Mega Battle",
  "englishName": "VS Tropical Mega Battle",
  "era": {
    "$kind": "era",
    "id": "english/neo-series",
