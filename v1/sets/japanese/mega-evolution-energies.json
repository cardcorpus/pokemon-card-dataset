  "description": {
    "text": "Japanese basic Energy cards of the MEGA series, marked with a three-letter type code (GRA, FIR, WAT and so on) where other cards carry a set symbol and number. They came in the Premium Trainer Box MEGA, one of the series' launch products, released with Mega Brave and Mega Symphonia on 1 August 2025: twelve of each type among its 172 cards, the only cards in the box without the product's symbol and collection number. The design is the one English cards use for Mega Evolution basic Energy.",
    "sources": [
      {
        "title": "Bulbapedia: Premium Trainer Box MEGA (TCG) (Wayback Machine copy, 26 August 2026)",
        "url": "https://web.archive.org/web/20260826025909/https://bulbapedia.bulbagarden.net/wiki/Premium_Trainer_Box_MEGA_(TCG)"
      }
    ]
  },
  "tell": {
    "text": "No mark or number, only a three-letter type code at the bottom left",
    "sources": [
      {
        "title": "Pokémon Card Game 30th Anniversary Archive (The Pokémon Company): each card's expansion mark",
        "url": "https://www.30tharchive.pokemon-card.com/"
      },
      {
        "title": "Bulbapedia: Premium Trainer Box MEGA (TCG) (Wayback Machine copy, 26 August 2026)",
        "url": "https://web.archive.org/web/20260826025909/https://bulbapedia.bulbagarden.net/wiki/Premium_Trainer_Box_MEGA_(TCG)"
      }
    ]
  },
