  "description": {
    "text": "A small blister pack released on 18 November 2016, the day Pokémon Sun and Moon came out, holding the first four cards of Japan's Sun & Moon era: Pikachu with the three Alola first partner Pokémon, Rowlet, Litten and Popplio. They were the first cards with the new layout of the era, which moved the Pokédex details to the bottom right and the number, rarity and set symbol to the bottom left.",
    "sources": [
      {
        "title": "Bulbapedia: Pikachu's New Friends (TCG) (Wayback Machine copy, 20 December 2025)",
        "url": "https://web.archive.org/web/20251220042953/https://bulbapedia.bulbagarden.net/wiki/Pikachu%27s_New_Friends_(TCG)"
      }
    ]
  },
  "tell": {
    "text": "An \"SM0\" mark at the bottom left, and a number out of 004",
    "sources": [
      {
        "title": "Pokémon Card Game 30th Anniversary Archive (The Pokémon Company): each card's expansion mark",
        "url": "https://www.30tharchive.pokemon-card.com/"
      }
    ]
  },
