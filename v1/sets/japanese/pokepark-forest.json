  "description": {
    "text": "One of two premium file folders released on 18 March 2005 for the opening of the PokéPark theme park in Nagoya, each holding nine cards of Pokémon from the park's attractions and sold separately. The Forest file's cards are all owned by the park, from PokéPark's Celebi and PokéPark's Pikachu to PokéPark's Jirachi, so none was released outside Japan. Together the nine illustrations form one forest scene by Kanako Eo, which also appears on the back of the folder and on a sticker inside.",
    "sources": [
      {
        "title": "Bulbapedia: PokéPark Premium Files (TCG) (Wayback Machine copy, 8 September 2026)",
        "url": "https://web.archive.org/web/20260908202020/https://bulbapedia.bulbagarden.net/wiki/Pok%C3%A9Park_Premium_Files_(TCG)"
      }
    ]
  },
  "tell": {
    "text": "A black tree symbol at the bottom right, and a number out of 009",
    "sources": [
      {
        "title": "Bulbapedia: PokéPark Premium Files (TCG) (Wayback Machine copy, 8 September 2026)",
        "url": "https://web.archive.org/web/20260908202020/https://bulbapedia.bulbagarden.net/wiki/Pok%C3%A9Park_Premium_Files_(TCG)"
      }
    ]
  },
