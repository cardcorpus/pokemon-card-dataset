      },
      "names": {
        "de": "Kirlia",
        "en": "Kirlia",
        "es": "Kirlia",
        "fr": "Kirlia",
        "it": "Kirlia",
        "ja": "キルリア",
        "ko": "킬리아",
        "ja-Hrkt": "キルリア",
        "zh-Hans": "奇鲁莉安",
        "zh-Hant": "奇魯莉安"
      },
      "description": {
        "fun": "Kirlia uses its hairpin-like horns to amplify its psychic power, warping the air into mirages and even glimpsing the future. It loves to dance on sunny mornings, grows more beautiful the happier its Trainer is, and even dances in its sleep, apparently dreaming of fun times ahead. Its name comes from Kirlian photography, said to capture psychic auras.",
        "guide": "A Psychic- and Fairy-type Pokémon (purely Psychic before Generation 6), the middle stage of the Ralts line, resembling a ballet dancer. It can see the future and loves to dance. It evolves into Gardevoir at level 30, or into Gallade if male and exposed to a Dawn Stone.",
        "tagline": "A ballet-dancing psychic that glimpses happy futures",
        "sources": [
          {
            "title": "Bulbapedia: Kirlia (Pokémon)",
            "url": "https://bulbapedia.bulbagarden.net/wiki/Kirlia_(Pok%C3%A9mon)"
          }
        ]
      },
      "branches": {
        "text": "Kirlia becomes Gardevoir at level 30 whatever its gender, but a male Kirlia exposed to a Dawn Stone becomes Gallade instead. Gallade arrived in Generation 4, a generation after the rest of the family.",
        "sources": [
          {
            "title": "Bulbapedia: Kirlia (Pokémon)",
            "url": "https://bulbapedia.bulbagarden.net/wiki/Kirlia_(Pok%C3%A9mon)"
          },
          {
