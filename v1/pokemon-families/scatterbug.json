      },
      "names": {
        "de": "Puponcho",
        "en": "Spewpa",
        "es": "Spewpa",
        "fr": "Pérégrain",
        "it": "Spewpa",
        "ja": "コフーライ",
        "ko": "분떠도리",
        "ja-Hrkt": "コフーライ",
        "zh-Hans": "粉蝶蛹",
        "zh-Hant": "粉蝶蛹"
      },
      "description": {
        "fun": "Unlike most cocoon Pokémon, Spewpa doesn't sit still: it wanders across fields and mountains, building up energy for its evolution. Its spiky white fur is studded with square specks, and when a predator such as Rufflet comes near, it bristles that fur or sprays poisonous powder. It's modelled on case-bearing moth larvae that build snug cases of fibres around themselves.",
        "guide": "Spewpa is a Bug-type Pokémon, the cocoon stage between Scatterbug and Vivillon. It is covered in sharp white fur, which it bristles or uses with a poisonous powder to fend off predators. Unusually for a cocoon, it travels widely before evolving.",
        "tagline": "A wandering cocoon that bristles when threatened",
        "sources": [
          {
            "title": "Bulbapedia: Spewpa (Pokémon)",
            "url": "https://bulbapedia.bulbagarden.net/wiki/Spewpa_(Pok%C3%A9mon)"
          }
        ]
      },
