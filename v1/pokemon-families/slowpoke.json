          },
          "description": {
            "fun": "The Shellder swallows almost all of Slowbro, leaving only its head, arms and tail poking out, and hardens into armour nothing can scratch. Slowbro balances on its tail and bounces around on it like a spring, barely changed inside.",
            "sources": [
              {
                "title": "Bulbapedia: Slowbro (Pokémon)",
                "url": "https://bulbapedia.bulbagarden.net/wiki/Slowbro_(Pok%C3%A9mon)"
              }
            ]
          },
          "term": "mega"
        },
