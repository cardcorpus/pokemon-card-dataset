      },
      "names": {
        "de": "Hokumil",
        "en": "Milcery",
        "es": "Milcery",
        "fr": "Crèmy",
        "it": "Milcery",
        "ja": "マホミル",
        "ko": "마빌크",
        "ja-Hrkt": "マホミル",
        "zh-Hans": "小仙奶",
        "zh-Hant": "小仙奶"
      },
      "description": {
        "fun": "A little dollop of cream born from sweet-smelling particles in the air. Milcery swells as it soaks up sweet aromas and slowly deflates when its energy runs low. If attacked, it smothers its foe in cream and slips away while they're blinded, or simply astonished at how delicious it is. Patisseries it visits are said to be guaranteed success.",
        "guide": "A small Fairy-type Pokémon made of cream, born from sweet aromas in the air. Milcery is female-only and evolves into Alcremie when spun around while holding a Sweet.",
        "tagline": "A living dollop of cream that brings bakeries luck",
        "sources": [
          {
            "title": "Bulbapedia: Milcery (Pokémon)",
            "url": "https://bulbapedia.bulbagarden.net/wiki/Milcery_(Pok%C3%A9mon)"
          }
        ]
      },
      "forms": [
