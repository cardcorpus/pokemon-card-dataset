    {
      "dex": 869,
      "name": "Alcremie",
      "generation": 8,
      "category": "Cream Pokémon",
      "family": {
        "$kind": "pokemon-family",
        "family": "milcery"
      },
      "names": {
        "de": "Pokusan",
        "en": "Alcremie",
        "es": "Alcremie",
        "fr": "Charmilly",
        "it": "Alcremie",
        "ja": "マホイップ",
        "ko": "마휘핑",
        "ja-Hrkt": "マホイップ",
        "zh-Hans": "霜奶仙",
        "zh-Hant": "霜奶仙"
      },
      "description": {
        "fun": "When Alcremie trusts a Trainer, it treats them to Berries decorated with its cream, and the happier it feels, the sweeter that cream tastes. Pastry chefs dream of having one as a partner. Nine creams and seven Sweets make 63 different looks, and with its Gigantamax form Alcremie has 64 recognised forms, more than any other Pokémon.",
        "guide": "The evolution of Milcery, a Fairy-type Pokémon made of whipped cream, designed by Atsuko Nishida. How Milcery was spun and which Sweet it held decide Alcremie's cream and decoration, for 63 combinations. It has a Gigantamax form.",
        "tagline": "A whipped-cream Pokémon in more flavours than any other",
        "sources": [
          {
            "title": "Bulbapedia: Alcremie (Pokémon)",
            "url": "https://bulbapedia.bulbagarden.net/wiki/Alcremie_(Pok%C3%A9mon)"
          }
        ]
      },
