      },
      "names": {
        "de": "Typ:Null",
        "en": "Type: Null",
        "es": "Código Cero",
        "fr": "Type:0",
        "it": "Tipo Zero",
        "ja": "タイプ：ヌル",
        "ko": "타입:널",
        "ja-Hrkt": "タイプ：ヌル",
        "zh-Hans": "属性：空",
        "zh-Hant": "屬性：空"
      },
      "description": {
        "fun": "Type: Null was made by the Aether Foundation as a 'beast killer' to fight Ultra Beasts, built from cells of every type so it could switch type by holding a Memory. All three prototypes rejected the system and went berserk, so they were fitted with heavy helmets that hold back their power and put into cold storage, and the creature, first named Type: Full, was renamed Type: Null. It's the only Pokémon with a colon in its English name.",
        "guide": "Type: Null is a Normal-type Legendary Pokémon from Alola, an artificial chimera created to fight Ultra Beasts. It wears a heavy helmet that suppresses its power. It evolves into Silvally with high friendship, breaking the helmet as it does.",
        "tagline": "A helmeted beast-killer experiment held back by its own mask",
        "sources": [
          {
            "title": "Bulbapedia: Type: Null (Pokémon)",
            "url": "https://bulbapedia.bulbagarden.net/wiki/Type:_Null_(Pok%C3%A9mon)"
          }
        ]
      },
      "forms": [
