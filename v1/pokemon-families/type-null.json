    {
      "dex": 773,
      "name": "Silvally",
      "generation": 7,
      "category": "Synthetic Pokémon",
      "status": "legendary",
      "family": {
        "$kind": "pokemon-family",
        "family": "type-null"
      },
      "names": {
        "de": "Amigento",
        "en": "Silvally",
        "es": "Silvally",
        "fr": "Silvallié",
        "it": "Silvally",
        "ja": "シルヴァディ",
        "ko": "실버디",
        "ja-Hrkt": "シルヴァディ",
        "zh-Hans": "银伴战兽",
        "zh-Hant": "銀伴戰獸"
      },
      "description": {
        "fun": "Once Type: Null bonds deeply with a Trainer, it finds the strength to smash its control helmet and evolves into Silvally, its true form. Freed from the mask, its RKS System switches back on, letting it change type to match whichever Memory it holds. It's wild at heart but fiercely loyal, and it will risk its life to protect its partner.",
        "guide": "Silvally is a Normal-type Legendary Pokémon that evolves from Type: Null, created to fight Ultra Beasts. Its RKS System Ability changes its type and colours to match the Memory it holds, and it is the only Pokémon that learns Multi-Attack. It is based on the chimera.",
        "tagline": "A freed beast killer that changes type with every Memory",
        "sources": [
          {
            "title": "Bulbapedia: Silvally (Pokémon)",
            "url": "https://bulbapedia.bulbagarden.net/wiki/Silvally_(Pok%C3%A9mon)"
          }
        ]
      },
