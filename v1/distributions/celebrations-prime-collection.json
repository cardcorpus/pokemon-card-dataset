      {
        "title": "Bulbapedia: Sword & Shield TCG Series merchandise, Celebrations Prime Collection",
        "url": "https://bulbapedia.bulbagarden.net/wiki/Sword_%26_Shield_TCG_Series_merchandise#Celebrations_Prime_Collection"
      },
      {
