      {
        "title": "Bulbapedia: Stellar Crown (TCG), additional cards",
        "url": "https://bulbapedia.bulbagarden.net/wiki/Stellar_Crown_(TCG)#Additional_Cards"
      },
      {
        "title": "Bulbapedia: Budew (Prismatic Evolutions 4)",
