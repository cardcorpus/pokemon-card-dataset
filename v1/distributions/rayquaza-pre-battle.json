{
  "id": "rayquaza-pre-battle",
  "name": "Rayquaza Pre-Battle",
  "category": "event",
  "description": {
    "text": "The Rayquaza Pre-Battle was held at Pokémon Card Gym shops and Pokémon Centers across Japan from 1 to 30 April 2015 to mark the Rayquaza Mega Battle. Every participant got a Gym Badge and Pokémon Card Gym Promotional Card Pack 4, and the top three got one to three more packs. There were eight Gym Badge prints, one for each Hoenn Gym Leader, and each was given in one region of Japan; each Pokémon Center gave a print from another region.",
    "sources": [
      {
        "title": "Pokémon Card Game official site: Rayquaza Pre-Battle",
        "url": "https://www.pokemon-card.com/event/card-event/rpb/"
      },
      {
        "title": "Bulbapedia: Gym Badge (XY Promo 203)",
        "url": "https://bulbapedia.bulbagarden.net/wiki/Gym_Badge_(XY_Promo_203)"
      }
    ]
  },
