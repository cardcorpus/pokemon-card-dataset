      {
        "title": "Bulbapedia: Mega Evolution TCG Series merchandise, Mega Evolution Build & Battle Box",
        "url": "https://bulbapedia.bulbagarden.net/wiki/Mega_Evolution_TCG_Series_merchandise#Mega_Evolution_Build_%26_Battle_Box"
      },
      {
        "title": "Bulbapedia: Mega Evolution Build & Battle Box (TCG)",
        "url": "https://bulbapedia.bulbagarden.net/wiki/Mega_Evolution_Build_%26_Battle_Box_(TCG)"
      }
    ]
  },
