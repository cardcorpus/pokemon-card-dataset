      },
      {
        "title": "Elite Fourum: Collector's Guide to Pokémon Asia Championship Series Promos (Part 1: Past System)",
        "url": "https://www.elitefourum.com/t/collectors-guide-to-pokemon-asia-championship-series-promos-part-1-past-system/48622"
      }
    ]
  },
