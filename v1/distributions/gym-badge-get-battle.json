{
  "id": "gym-badge-get-battle",
  "name": "Gym Badge Get Battle",
  "category": "event",
  "description": {
    "text": "Held at Pokémon Card Gym shops across Japan from 1 October to 30 November 2016. Every participant got a Gym Badge card for one of the eight Kanto Gym Leaders, four available only in October and four only in November, and the top three of each tournament a cosmos holo copy. The same non-holo badges were Play Point prizes at the 20th Anniversary Festa and gifts at Pokémon Circle events at university festivals that autumn.",
    "sources": [
      {
        "title": "Bulbapedia: Gym Badge (XY Promo 203)",
        "url": "https://bulbapedia.bulbagarden.net/wiki/Gym_Badge_(XY_Promo_203)"
      }
    ]
  },
