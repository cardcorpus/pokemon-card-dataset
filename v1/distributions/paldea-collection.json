{
  "id": "paldea-collection",
  "name": "Paldea Collection",
  "category": "product_promotion",
  "description": {
    "text": "Three boxes released on 6 January 2023, the first English Scarlet & Violet product, one for each Paldea first partner. Each held an enamel pin and an SVP promo of its featured Pokémon (Sprigatito SVP 001, Fuecoco SVP 002 or Quaxly SVP 003), mirage holofoil copies of the other two from the coming Scarlet & Violet set, found in no booster pack, and a jumbo Koraidon ex or Miraidon ex with parts of its text hidden to tease Pokémon ex. Four booster packs and a code card for Pokémon TCG Live completed each box.",
    "sources": [
      {
        "title": "Bulbapedia: Scarlet & Violet TCG Series merchandise, Paldea Collection",
        "url": "https://bulbapedia.bulbagarden.net/wiki/Scarlet_%26_Violet_TCG_Series_merchandise#Paldea_Collection"
      },
      {
        "title": "Bulbapedia: Scarlet & Violet (TCG), additional cards",
        "url": "https://bulbapedia.bulbagarden.net/wiki/Scarlet_%26_Violet_(TCG)#Additional_cards"
      },
      {
        "title": "Bulbapedia: Jumbo cards (TCG)",
        "url": "https://bulbapedia.bulbagarden.net/wiki/Jumbo_cards_(TCG)"
      }
    ]
  },
