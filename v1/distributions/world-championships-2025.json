        "url": "https://www.pokeguardian.com/2658013_pokemon-worlds-2025-coverage-live-updates"
      },
      {
        "title": "Elite Fourum: 2025 Worlds in Anaheim, Paradise Resort SVP224",
        "url": "https://www.elitefourum.com/t/2025-worlds-is-in-anaheim-california/49866/95"
      }
    ]
  },
