{
  "id": "evolutions-prerelease-kit",
  "name": "Evolutions Prerelease Kit",
  "category": "product_promotion",
  "description": {
    "text": "Given to players at the Evolutions prerelease tournaments on the weekends of 22–23 and 29–30 October 2016. Each kit held four Evolutions booster packs and a 23-card Evolution pack built around a holofoil copy of one of four of the set's own cards with the Evolutions logo: Charizard, Gyarados, Mewtwo or Machamp, each with a group of Pokémon of its type. The packs also held non-holo copies of Ninetales, Poliwrath, Nidoking, Mew and Hitmonchan, which booster packs have only in holofoil.",
    "sources": [
      {
        "title": "Bulbapedia: Evolutions (TCG), additional cards",
        "url": "https://bulbapedia.bulbagarden.net/wiki/Evolutions_(TCG)#Additional_cards"
      },
      {
        "title": "Bulbapedia: XY TCG Series merchandise, Evolutions Prerelease Kit",
        "url": "https://bulbapedia.bulbagarden.net/wiki/XY_TCG_Series_merchandise#Evolutions_Prerelease_Kit"
      },
      {
        "title": "Bulbapedia: Evolutions Prerelease Kit (TCG)",
        "url": "https://bulbapedia.bulbagarden.net/wiki/Evolutions_Prerelease_Kit_(TCG)"
      }
    ]
