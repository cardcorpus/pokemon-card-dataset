      {
        "title": "Bulbapedia: Mega Evolution TCG Series merchandise, Pitch Black Build & Battle Box",
        "url": "https://bulbapedia.bulbagarden.net/wiki/Mega_Evolution_TCG_Series_merchandise#Pitch_Black_Build_%26_Battle_Box"
      },
      {
        "title": "Bulbapedia: Pitch Black Build & Battle Box (TCG)",
        "url": "https://bulbapedia.bulbagarden.net/wiki/Pitch_Black_Build_%26_Battle_Box_(TCG)"
      }
    ]
  },
