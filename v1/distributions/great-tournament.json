{
  "id": "great-tournament",
  "name": "Great Tournament",
  "category": "event",
  "description": {
    "text": "Simplified Chinese holo Great Ball cards were the placement prizes of China's Super Tournaments (超级赛): first the Qingdao Super Tournament (青岛超级赛) of the Sun & Moon era, then the Super Tournaments of the Scarlet & Violet era. Each copy is stamped with its placing: Top 64 for the final top 64 (of all divisions at Qingdao, of the open division later), Top 8 for players who finished third to eighth, and 2nd Place and Champion for each division's runner-up and winner.",
    "sources": [
      {
        "title": "52Poké Wiki: SM-P Simplified Chinese promo cards",
        "url": "https://wiki.52poke.com/wiki/SM-P%E7%AE%80%E4%BD%93%E4%B8%AD%E6%96%87%E7%89%88%E7%89%B9%E5%85%B8%E5%8D%A1%EF%BC%88TCG%EF%BC%89"
      },
      {
        "title": "52Poké Wiki: SV-P Simplified Chinese promo cards",
        "url": "https://wiki.52poke.com/wiki/SV-P%E7%AE%80%E4%BD%93%E4%B8%AD%E6%96%87%E7%89%88%E7%89%B9%E5%85%B8%E5%8D%A1%EF%BC%88TCG%EF%BC%89"
      }
    ]
  },
