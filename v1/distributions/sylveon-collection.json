{
  "id": "sylveon-collection",
  "name": "Sylveon Collection",
  "category": "product_promotion",
  "description": {
    "text": "A box released on 15 November 2013 that brought Sylveon's first card, the sheen holofoil promo XY04, before even Japan had one. It also held a Sylveon figure, a Fairy Energy, four Black & White Series booster packs and cosmos holofoil promos of Eevee and its seven other evolutions of the time, BW87 to BW94. The Pokémon Company's art team drew those eight for a Japanese File Collection released on 23 November 2012 during the Pokémon Center's Eevee Collection campaign; the evolutions have the attacks of their Dark Explorers cards.",
    "sources": [
      {
        "title": "Bulbapedia: XY TCG Series merchandise",
        "url": "https://bulbapedia.bulbagarden.net/wiki/XY_TCG_Series_merchandise"
      },
      {
        "title": "PokéBeach: New ‘Sylveon Collection’ Debuting in November! (26 September 2013)",
        "url": "https://www.pokebeach.com/2013/09/new-sylveon-collection-in-november"
      },
      {
        "title": "Bulbapedia: Sylveon (XY Promo 4), release information",
        "url": "https://bulbapedia.bulbagarden.net/wiki/Sylveon_(XY_Promo_4)#Release_information"
      },
      {
        "title": "Pokumon: Eevee (189/BW-P Japanese Promo)",
        "url": "https://pokumon.com/card/eevee-189-bw-p-japanese-promo/"
      }
    ]
  },
