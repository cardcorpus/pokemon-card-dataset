{
  "id": "oceania-international-championships",
  "name": "Oceania International Championships",
  "category": "event",
  "description": {
    "text": "The Oceania International Championships are one of the International Championships that Play! Pokémon has held since the 2017 season, alongside North America, Europe and Latin America. Each International Championships promo came as a plain copy for every competitor, a Staff copy, and Top 8 and Champion copies for the players who reached the top eight of each division and for each division's winner.\n\nThe first, on 10-12 March 2017, gave out Evolutions' Double Colorless Energy. Sun & Moon's Ultra Ball followed in 2018, the alternate-art Guardians Rising Choice Band numbered 121a in 2019, the alternate-art Team Up Pokémon Communication numbered 152a in 2020, and Brilliant Stars' Ultra Ball in 2023.",
    "sources": [
      {
        "title": "Elite Fourum: Championship stamped Double Colorless Energy",
        "url": "https://www.elitefourum.com/t/championship-stamped-double-colorless-energy/20835"
      },
      {
        "title": "Elite Fourum: International promos, how many versions?",
        "url": "https://www.elitefourum.com/t/international-promos-how-many-versions-languages/26482"
      },
      {
        "title": "Elite Fourum: Prerelease/Staff Card Rarity? (staff cards by year, XY and later)",
        "url": "https://www.elitefourum.com/t/prerelease-staff-card-rarity/25783/23"
      },
      {
        "title": "Bulbapedia: Brilliant Stars (TCG)",
        "url": "https://bulbapedia.bulbagarden.net/wiki/Brilliant_Stars_(TCG)"
      }
    ]
  },
