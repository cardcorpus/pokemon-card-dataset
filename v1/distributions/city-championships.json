      },
      {
        "title": "Bulbapedia: Furious Fists (TCG), additional cards",
        "url": "https://bulbapedia.bulbagarden.net/wiki/Furious_Fists_(TCG)#Additional_cards"
      },
      {
        "title": "Bulbapedia: Miscellaneous Promotional cards (TCG)/2015-2018, 2015",
        "url": "https://bulbapedia.bulbagarden.net/wiki/Miscellaneous_Promotional_cards_(TCG)/2015-2018#2015"
      }
    ]
  },
