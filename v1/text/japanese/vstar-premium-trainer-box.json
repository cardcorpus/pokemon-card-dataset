    { "$kind": "card", "set": "japanese/vstar-premium-trainer-box", "id": "004", "name": "ユキメノコ", "number": { "printed": "004/030", "short": "004" }, "text": { "name": "ユキメノコ", "level": null, "kind": "pokemon", "subtype": null, "stage": "Stage 1", "evolvesFrom": "ユキワラシ", "hp": 90, "types": ["Water"], "markers": [], "abilities": [{ "label": "特性", "name": "しもふらし", "text": "自分の番に、このカードを手札から出して進化させたとき、1回使える。自分のトラッシュから{Water}エネルギーを1枚選び、自分のポケモンにつける。" }], "attacks": [{ "label": null, "cost": ["Water", "Colorless"], "name": "クリスタルブレス", "damage": "90", "text": "次の自分の番、このポケモンはワザが使えない。" }], "effect": [], "rules": [], "weakness": [{ "type": "Metal", "value": "×2" }], "resistance": [], "retreat": 1, "flavor": "マイナス５０度の 冷気を 吐き 凍らせた 獲物を すみかに 持ち帰り きれいに 並べる。" }, "checked": "source" },
    { "$kind": "card", "set": "japanese/vstar-premium-trainer-box", "id": "005", "name": "メリープ", "number": { "printed": "005/030", "short": "005" }, "text": { "name": "メリープ", "level": null, "kind": "pokemon", "subtype": null, "stage": "Basic", "evolvesFrom": null, "hp": 70, "types": ["Lightning"], "markers": [], "abilities": [], "attacks": [{ "label": null, "cost": ["Colorless"], "name": "なきごえ", "damage": "", "text": "次の相手の番、このワザを受けたポケモンが使うワザのダメージは「-20」される。" }, { "label": null, "cost": ["Lightning", "Colorless"], "name": "バチバチ", "damage": "20", "text": "" }], "effect": [], "rules": [], "weakness": [{ "type": "Fighting", "value": "×2" }], "resistance": [], "retreat": 2, "flavor": "綿毛が こすれ 電気が たまる。 かわいいからと 素手で 触ると バチッと 痺れて 痛いのだ。" }, "checked": "source" },
    { "$kind": "card", "set": "japanese/vstar-premium-trainer-box", "id": "006", "name": "モココ", "number": { "printed": "006/030", "short": "006" }, "text": { "name": "モココ", "level": null, "kind": "pokemon", "subtype": null, "stage": "Stage 1", "evolvesFrom": "メリープ", "hp": 90, "types": ["Lightning"], "markers": [], "abilities": [{ "label": "特性", "name": "エレキダイナモ", "text": "自分の番に1回使える。自分のトラッシュから{Lightning}エネルギーを1枚選び、ベンチポケモンにつける。" }], "attacks": [{ "label": null, "cost": ["Lightning", "Lightning", "Colorless"], "name": "エレキボール", "damage": "50", "text": "" }], "effect": [], "rules": [], "weakness": [{ "type": "Fighting", "value": "×2" }], "resistance": [], "retreat": 2, "flavor": "ふかふかの 毛に 電気を ためこむ。 蓄えすぎて ところどころ つるつるに 禿げあがって しまった。" }, "checked": "source" },
    { "$kind": "card", "set": "japanese/vstar-premium-trainer-box", "id": "007", "name": "ミュウ", "number": { "printed": "007/030", "short": "007" }, "text": { "name": "ミュウ", "level": null, "kind": "pokemon", "subtype": null, "stage": "Basic", "evolvesFrom": null, "hp": 60, "types": ["Psychic"], "markers": [], "abilities": [{ "label": "特性", "name": "ふしぎなしっぽ", "text": "このポケモンがバトル場にいるなら、自分の番に1回使える。自分の山札を上から6枚見る。その中からグッズを1枚選び、相手に見せて、手札に加える。残りのカードは山札にもどして切る。" }], "attacks": [{ "label": null, "cost": ["Psychic", "Colorless"], "name": "サイコショット", "damage": "30", "text": "" }], "effect": [], "rules": [], "weakness": [{ "type": "Darkness", "value": "×2" }], "resistance": [{ "type": "Fighting", "value": "－30" }], "retreat": 1, "flavor": "遺伝子には すべての ポケモンの 情報が 含まれているので あらゆる 技が 使えるという。" }, "checked": "source" },
