    { "$kind": "card", "set": "japanese/moonlit-pursuit", "id": "dpbp-168", "name": "オムナイト", "number": { "printed": "DPBP#168", "short": "DPBP#168" }, "text": { "name": "オムナイト", "level": 37, "kind": "pokemon", "subtype": null, "stage": "Stage 1", "evolvesFrom": null, "hp": 70, "types": ["Water"], "markers": [], "abilities": [{ "label": "ポケパワー", "name": "よびおこす", "text": "自分の番に1回使える。コインを1回投げオモテなら、自分のトラッシュから、「かいの化石」「こうらの化石」「ひみつのコハク」のうち1枚を選び、自分のベンチに出す。このパワーは、このポケモンが特殊状態なら使えない。" }], "attacks": [{ "label": null, "cost": ["Water", "Colorless"], "name": "オーバーウェーブ", "damage": "20", "text": "相手のベンチポケモン2匹にも、それぞれ10ダメージ。" }], "effect": [], "rules": [], "weakness": [{ "type": "Grass", "value": "＋20" }], "resistance": [], "retreat": 1, "flavor": "げんだいの すぐれた かがくりょくで かせきから ふっかつした ポケモン。 こだいの うみを およいでいた。" }, "checked": "source" },
    { "$kind": "card", "set": "japanese/moonlit-pursuit", "id": "dpbp-169", "name": "オムスター", "number": { "printed": "DPBP#169", "short": "DPBP#169" }, "text": { "name": "オムスター", "level": 53, "kind": "pokemon", "subtype": null, "stage": "Stage 2", "evolvesFrom": "オムナイト", "hp": 110, "types": ["Water"], "markers": [], "abilities": [{ "label": "ポケパワー", "name": "げんしのうず", "text": "自分の番に、このカードを手札から出してポケモンを進化させたとき、1回使える。相手のベンチの進化ポケモン全員を、それぞれ1進化ぶん退化させる。退化のためにはがした「ポケモンのカード」は、相手プレイヤーの手札にもどす。この番に、すでに別の「げんしのうず」を使っていたなら、このパワーは使えない。" }], "attacks": [{ "label": null, "cost": ["Water", "Colorless"], "name": "つきかえす", "damage": "40", "text": "相手を相手のベンチポケモンと入れ替える。入れ替えるベンチポケモンは相手プレイヤーが選ぶ。" }], "effect": [], "rules": [], "weakness": [{ "type": "Grass", "value": "＋30" }], "resistance": [], "retreat": 1, "flavor": "らせんじょうの カラが おおきく なりすぎたことが げんいんで ぜつめつしたと かんがえられている。" }, "checked": "source" },
    { "$kind": "card", "set": "japanese/moonlit-pursuit", "id": "dpbp-176", "name": "サンダー", "number": { "printed": "DPBP#176", "short": "DPBP#176" }, "text": { "name": "サンダー", "level": 45, "kind": "pokemon", "subtype": null, "stage": "Basic", "evolvesFrom": null, "hp": 100, "types": ["Lightning"], "markers": [], "abilities": [{ "label": "ポケパワー", "name": "ライトニングボルト", "text": "自分の番に、このカードを手札からベンチに出したとき、1回使える。コインを1回投げオモテなら、相手のポケモン全員に、ダメージカウンターを、それぞれ1個ずつのせる。" }], "attacks": [{ "label": null, "cost": ["Lightning", "Lightning", "Colorless"], "name": "らくらい", "damage": "80", "text": "自分のポケモン1匹にも、弱点・抵抗力に関係なく、40ダメージ。" }], "effect": [], "rules": [], "weakness": [{ "type": "Lightning", "value": "×2" }], "resistance": [{ "type": "Fighting", "value": "－20" }], "retreat": 2, "flavor": "かみなりぐもの なかに いると いわれる でんせつの ポケモン。 カミナリを じざいに あやつる。" }, "checked": "source" },
