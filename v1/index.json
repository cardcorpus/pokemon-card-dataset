{
  "name": "CardCorpus",
  "description": "Open Pokémon TCG dataset (sets, cards, Pokémon, and the links between them) as a static JSON API. Each picture is an id on our image mirror; `pictures` turns one into the url of a copy 240, 480 or 960 px wide. TCGplayer and Cardmarket product ids are in marketplaces/, `marketplaces` turns them into links, and `prices` names where each set's daily prices are served; other sources' ids are excluded. `files` lists every file with its JSON Schema, `pointers` how to find what a pointer points at, and `moved.json` every published address that no longer resolves.",
  "version": "2.0.0",
  "docs": {
    "guide": "docs/guide.md",
    "reference": "docs/reference.md"
  },
  "pictures": {
    "sized": "https://img.cardcorpus.com/s1/{width}/{id}.avif",
    "widths": [
      240,
      480,
      960
    ]
  },
  "prices": {
    "latest": "https://prices.cardcorpus.com/{set}.json",
    "sets": "https://prices.cardcorpus.com/sets.json?sets={sets}",
    "history": "https://prices.cardcorpus.com/history/{set}/{card}.json",
    "rates": "https://prices.cardcorpus.com/rates.json",
    "schemas": {
      "latest": "schema/prices.schema.json",
      "sets": "schema/prices-sets.schema.json",
      "history": "schema/price-history.schema.json",
      "rates": "schema/exchange-rates.schema.json"
    }
  },
  "marketplaces": {
    "tcgplayer": "https://www.tcgplayer.com/product/{product}",
    "cardmarket": "https://www.cardmarket.com/en/Pokemon/Products?idProduct={product}"
  },
