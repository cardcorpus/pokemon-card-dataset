  "pointers": {
    "set": {
      "file": "sets/{id}.json",
      "path": []
    },
    "card": {
      "file": "sets/{set}.json",
      "path": [
        {
          "list": "cards",
          "match": "id",
          "by": "id"
        }
      ]
    },
    "variant": {
      "file": "sets/{set}.json",
      "path": [
        {
          "list": "cards",
          "match": "id",
          "by": "card"
        },
        {
          "list": "variants",
          "match": "id",
          "by": "id"
        }
      ]
    },
    "set-version": {
      "file": "sets/{set}.json",
      "path": [
        {
          "list": "versions",
          "match": "id",
          "by": "id"
        }
      ]
    },
    "painting": {
      "file": "paintings/{id}.json",
      "path": []
    },
    "play": {
      "file": "plays/{id}.json",
      "path": []
    },
    "era": {
      "file": "eras.json",
      "path": [
        {
          "list": "eras",
          "match": "id",
          "by": "id"
        }
      ]
    },
    "line": {
      "file": "lines.json",
      "path": [
        {
          "list": "lines",
          "match": "id",
          "by": "id"
        }
      ]
    },
    "species": {
      "file": "pokemon.json",
      "path": [
        {
          "list": "species",
          "match": "dex",
          "by": "id"
        }
      ]
    },
    "form": {
      "file": "pokemon.json",
      "path": [
        {
          "list": "species",
          "match": "dex",
          "by": "species"
        },
        {
          "list": "forms",
          "match": "id",
          "by": "id"
        }
      ]
    },
    "pokemon-family": {
      "file": "pokemon-families/{id}.json",
      "path": []
    },
    "artist": {
      "file": "artists.json",
      "path": [
        {
          "list": "artists",
          "match": "id",
          "by": "id"
        }
      ]
    },
