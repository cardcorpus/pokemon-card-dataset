{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CardCorpus distribution series",
  "description": "One distribution series in full: distributions that recur under one name, such as \"World Championships\", with one distribution for each year's event. It has what we wrote about the series where we have written it up, and its distributions in order.",
  "type": "object",
  "x-cc": {
    "label": "name"
  },
  "required": [
    "id",
    "name",
    "category",
    "distributions"
  ],
  "properties": {
    "id": {
      "description": "The distribution series' id (distribution-series/{id}.json).",
      "type": "string"
    },
    "name": {
      "description": "Its name.",
      "type": "string"
    },
    "category": {
      "description": "What kind of distribution it is: a product, an event, a program, a shop, a campaign, a publication, a test run or staff.",
      "x-cc": {
        "vocabulary": "distribution"
      },
      "allOf": [
        {
          "$ref": "#/$defs/vocabulary.distribution"
        }
      ]
    },
    "description": {
      "description": "What we wrote about the series, for people to read (https://pokemon.cardcorpus.com/v1/docs/guide.md#descriptions).",
      "type": "object",
      "required": [
        "text"
      ],
      "properties": {
        "text": {
          "description": "The text; paragraphs are split by a blank line.",
          "type": "string"
        }
      }
    },
    "distributions": {
      "description": "Its distributions, in order.",
      "type": "array",
      "items": {
        "type": "object",
        "x-cc": {
          "ref": "distribution"
        },
        "required": [
          "$kind",
          "id",
          "name",
          "short",
          "variantCount",
          "setCount",
          "catalogs"
        ],
        "properties": {
          "$kind": {
            "description": "What the pointer points at: `distribution`. index.json's `pointers` say where to find it (https://pokemon.cardcorpus.com/v1/docs/guide.md#pointers).",
            "const": "distribution"
          },
          "id": {
            "description": "The distribution's id (distributions/{id}.json).",
            "type": "string"
          },
          "name": {
            "description": "A copy of the target's own `name`.",
            "type": "string"
          },
          "short": {
            "description": "Its name in the series: what it adds to the series' name (\"2005\"), else its name.",
            "type": "string"
          },
          "variantCount": {
            "description": "How many variants that came out through it; always present, 0 included.",
            "type": "integer",
            "minimum": 0
          },
          "setCount": {
            "description": "How many sets that name it for every variant of them; always present, 0 included.",
            "type": "integer",
            "minimum": 0
          },
          "catalogs": {
            "description": "The catalogs its variants are in.",
            "type": "array",
            "items": {
              "description": "A catalog.",
              "x-cc": {
                "vocabulary": "catalog"
              },
              "allOf": [
                {
                  "$ref": "#/$defs/vocabulary.catalog"
                }
              ]
            }
          },
          "image": {
            "description": "Its first set's or first variant's picture.",
            "type": "string",
            "pattern": "^[0-9a-f]{32}$",
            "x-cc": {
              "picture": true
            }
          }
        }
      }
    }
  },
  "$defs": {
    "vocabulary.distribution": {
      "title": "Distribution",
      "description": "Every value of vocabulary.json's `distribution`.",
      "type": "string",
      "enum": [
        "product_promotion",
        "event",
        "program",
        "retailer_promotion",
        "prize",
        "campaign",
        "staff",
        "publication_promotion",
        "test"
      ]
    },
    "vocabulary.catalog": {
      "title": "Catalog",
      "description": "Every value of vocabulary.json's `catalog`.",
      "type": "string",
      "enum": [
        "english",
        "japanese",
        "zh-hans",
        "korean",
        "zh-hant",
        "thai",
        "indonesian",
        "french",
        "german",
        "italian",
        "spanish",
        "portuguese",
        "latin-american-spanish",
        "dutch",
        "russian",
        "polish"
      ]
    }
  }
}
