{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CardCorpus marketplace ids of a set",
  "description": "The TCGplayer and Cardmarket products that sell one set's cards: each card by its id with every product its records name, and each of its variants by its id with the one product that prices it, TCGplayer's product and subtype, Cardmarket's product and, with reverseHolo, the price guide's -holo fields (https://pokemon.cardcorpus.com/v1/docs/guide.md#marketplace-ids).",
  "type": "object",
  "required": [
    "set",
    "cards"
  ],
  "properties": {
    "set": {
      "description": "The set's id (sets/{catalog}.json).",
      "type": "string"
    },
    "cards": {
      "description": "Each card, by its id.",
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "tcgplayer": {
            "description": "Every TCGplayer product its records name.",
            "type": "array",
            "items": {
              "description": "A TCGplayer product id.",
              "type": "integer",
              "minimum": 0
            }
          },
          "cardmarket": {
            "description": "Every Cardmarket product its records name.",
            "type": "array",
            "items": {
              "description": "A Cardmarket product id.",
              "type": "integer",
              "minimum": 0
            }
          },
          "variants": {
            "description": "Each of its variants, by its id, with the one product that prices it.",
            "type": "object",
            "additionalProperties": {
              "type": "object",
              "properties": {
                "tcgplayer": {
                  "description": "TCGplayer's product and subtype.",
                  "type": "object",
                  "required": [
                    "product",
                    "subtype"
                  ],
                  "properties": {
                    "product": {
                      "description": "The TCGplayer product id.",
                      "type": "integer",
                      "minimum": 0
                    },
                    "subtype": {
                      "description": "The price subtype (\"Holofoil\", \"Reverse Holofoil\").",
                      "type": "string"
                    }
                  }
                },
                "cardmarket": {
                  "description": "Cardmarket's product.",
                  "type": "object",
                  "required": [
                    "product"
                  ],
                  "properties": {
                    "product": {
                      "description": "The Cardmarket product id.",
                      "type": "integer",
                      "minimum": 0
                    },
                    "reverseHolo": {
                      "description": "Present where the variant is priced by the price guide's -holo fields.",
                      "const": true
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
