{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CardCorpus curated collections",
  "description": "Our curated collections: hand-picked lists of card variants that belong together across sets and languages, which no single set file gives you. \"All 25th Stamped Cards\" gathers every card with a 25th-anniversary stamp, from Celebrations to Happy Meals; \"Banned Cards\" the cards banned from play. Each collection is split into titled sections, and each section lists its variants.",
  "type": "object",
  "required": [
    "collections"
  ],
  "properties": {
    "collections": {
      "description": "Every collection, each complete in this file.",
      "type": "array",
      "items": {
        "type": "object",
        "x-cc": {
          "label": "title"
        },
        "required": [
          "id",
          "title",
          "updated",
          "description",
          "coverage",
          "sections"
        ],
        "properties": {
          "id": {
            "description": "The collection's id in collections.json.",
            "type": "string"
          },
          "title": {
            "description": "Its title: \"All 30th Stamped Cards\".",
            "type": "string"
          },
          "updated": {
            "description": "When we last checked it, a full date.",
            "type": "string",
            "format": "date"
          },
          "description": {
            "description": "What it collects, in a sentence or two for people to read.",
            "type": "string"
          },
          "coverage": {
            "description": "How complete it is and what it leaves out, in a sentence (which languages it covers, for one).",
            "type": "string"
          },
          "sections": {
            "description": "Its sections, in order.",
            "type": "array",
            "items": {
              "type": "object",
              "x-cc": {
                "label": "title"
              },
              "required": [
                "id",
                "title",
                "description",
                "variants"
              ],
              "properties": {
                "id": {
                  "description": "The section's id, unique in its collection.",
                  "type": "string"
                },
                "title": {
                  "description": "Its title.",
                  "type": "string"
                },
                "description": {
                  "description": "What we wrote about the section, for people to read (https://pokemon.cardcorpus.com/v1/docs/guide.md#descriptions).",
                  "type": "object",
                  "required": [
                    "text"
                  ],
                  "properties": {
                    "text": {
                      "description": "The text; paragraphs are split by a blank line.",
                      "type": "string"
                    }
                  }
                },
                "see": {
                  "description": "Our set and distribution pages its cards come from.",
                  "type": "array",
                  "items": {
                    "type": "object",
                    "x-cc": {
                      "ref": [
                        "set",
                        "distribution"
                      ],
                      "label": "name"
                    },
                    "required": [
                      "$kind",
                      "id",
                      "name",
                      "languages"
                    ],
                    "properties": {
                      "$kind": {
                        "description": "What the pointer points at: `set` or `distribution`. index.json's `pointers` say where to find it (https://pokemon.cardcorpus.com/v1/docs/guide.md#pointers).",
                        "enum": [
                          "set",
                          "distribution"
                        ]
                      },
                      "id": {
                        "description": "The set's id (sets/{catalog}.json) or the distribution's (distributions/{id}.json).",
                        "type": "string"
                      },
                      "name": {
                        "description": "A copy of the target's own `name`.",
                        "type": "string"
                      },
                      "category": {
                        "description": "A copy of the target's own `category`. Present on a `distribution`.",
                        "x-cc": {
                          "vocabulary": "distribution"
                        },
                        "allOf": [
                          {
                            "$ref": "#/$defs/vocabulary.distribution"
                          }
                        ]
                      },
                      "languages": {
                        "description": "The languages of its cards: a set's, or those of the sets holding a distribution's cards, English first, then Japanese, then Chinese. A section lists its pages in that order too.",
                        "type": "array",
                        "items": {
                          "description": "A language.",
                          "x-cc": {
                            "vocabulary": "language"
                          },
                          "allOf": [
                            {
                              "$ref": "#/$defs/vocabulary.language"
                            }
                          ]
                        }
                      }
                    }
                  }
                },
                "groups": {
                  "description": "Small groups of its variants that came the same way (one box, one deck), in order; each variant names its `group`.",
                  "type": "array",
                  "items": {
                    "type": "object",
                    "x-cc": {
                      "label": "title"
                    },
                    "required": [
                      "id",
                      "title"
                    ],
                    "properties": {
                      "id": {
                        "description": "The group's id, unique in its section.",
                        "type": "string"
                      },
                      "title": {
                        "description": "Its label.",
                        "type": "string"
                      }
                    }
                  }
                },
                "variants": {
                  "description": "Each variant by its pointer (the card's, where the collection names no variant).",
                  "type": "array",
                  "items": {
                    "type": "object",
                    "x-cc": {
                      "ref": [
                        "card",
                        "variant"
                      ]
                    },
                    "required": [
                      "$kind",
                      "set",
                      "id",
                      "language"
                    ],
                    "properties": {
                      "$kind": {
                        "description": "What the pointer points at: `card` or `variant`. index.json's `pointers` say where to find it (https://pokemon.cardcorpus.com/v1/docs/guide.md#pointers).",
                        "enum": [
                          "card",
                          "variant"
                        ]
                      },
                      "set": {
                        "description": "The set's id (sets/{catalog}.json).",
                        "type": "string"
                      },
                      "card": {
                        "description": "The card's id, unique in its set. On a `variant`: the card it is of.",
                        "type": "string"
                      },
                      "id": {
                        "description": "Its own id: the card's in its set, or the variant's among its card's variants.",
                        "type": "string"
                      },
                      "language": {
                        "description": "A copy of the target's own `language`.",
                        "x-cc": {
                          "vocabulary": "language"
                        },
                        "allOf": [
                          {
                            "$ref": "#/$defs/vocabulary.language"
                          }
                        ]
                      },
                      "note": {
                        "description": "Our note on why it is here.",
                        "type": "string"
                      },
                      "group": {
                        "description": "The id of the section's group it is in, when the section has groups.",
                        "type": "string"
                      },
                      "via": {
                        "description": "Set when the variant is here because it is a piece of a V-UNION or LEGEND card whose other piece qualifies, not on its own stamp.",
                        "enum": [
                          "v_union",
                          "legend"
                        ]
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "vocabulary.distribution": {
      "title": "Distribution",
      "description": "Every value of vocabulary.json's `distribution`.",
      "type": "string",
      "enum": [
        "product_promotion",
        "event",
        "program",
        "retailer_promotion",
        "prize",
        "campaign",
        "staff",
        "publication_promotion",
        "test"
      ]
    },
    "vocabulary.language": {
      "title": "Language",
      "description": "Every value of vocabulary.json's `language`.",
      "type": "string",
      "enum": [
        "ja",
        "en",
        "ko",
        "de",
        "it",
        "fr",
        "es",
        "zh-Hant",
        "pt",
        "id",
        "zh-Hans",
        "th",
        "es-419",
        "ru",
        "pl",
        "nl"
      ]
    }
  }
}
