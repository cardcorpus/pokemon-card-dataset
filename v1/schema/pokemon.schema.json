{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CardCorpus Pokémon",
  "description": "Every species with its forms, in National Pokédex order; each family in full is pokemon-families/{family}.json (https://pokemon.cardcorpus.com/v1/docs/guide.md#species-and-forms).",
  "type": "object",
  "required": [
    "speciesCount",
    "formCount",
    "familyCount",
    "transitionCount",
    "generations",
    "regions",
    "species"
  ],
  "properties": {
    "speciesCount": {
      "description": "How many species; always present, 0 included.",
      "type": "integer",
      "minimum": 0
    },
    "formCount": {
      "description": "How many forms; always present, 0 included.",
      "type": "integer",
      "minimum": 0
    },
    "familyCount": {
      "description": "How many evolution families; always present, 0 included.",
      "type": "integer",
      "minimum": 0
    },
    "transitionCount": {
      "description": "How many transitions between forms; always present, 0 included.",
      "type": "integer",
      "minimum": 0
    },
    "generations": {
      "description": "The region each generation's games are set in.",
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "generation",
          "region"
        ],
        "properties": {
          "generation": {
            "description": "The generation.",
            "type": "integer",
            "minimum": 1
          },
          "region": {
            "description": "Its region's name.",
            "type": "string"
          }
        }
      }
    },
    "regions": {
      "description": "The regions regional forms come from, by a form's `region`.",
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "x-cc": {
          "label": "label"
        },
        "required": [
          "label"
        ],
        "properties": {
          "label": {
            "description": "The region's name.",
            "type": "string"
          },
          "term": {
            "description": "The term for its forms (\"Alolan\").",
            "type": "string"
          }
        }
      }
    },
    "species": {
      "description": "Every species, in National Pokédex order.",
      "type": "array",
      "items": {
        "type": "object",
        "x-cc": {
          "label": "name"
        },
        "required": [
          "dex",
          "name",
          "generation",
          "family",
          "types",
          "forms",
          "cardCount",
          "totalCardCount"
        ],
        "properties": {
          "dex": {
            "description": "Its National Pokédex number.",
            "type": "integer",
            "minimum": 1
          },
          "name": {
            "description": "Its name.",
            "type": "string"
          },
          "generation": {
            "description": "The generation the species first appeared in.",
            "type": "integer",
            "minimum": 1
          },
          "category": {
            "description": "Its Pokédex category (\"Mouse Pokémon\").",
            "type": "string"
          },
          "status": {
            "description": "Where it is one: a baby, legendary or mythical Pokémon.",
            "enum": [
              "baby",
              "legendary",
              "mythical"
            ]
          },
          "family": {
            "description": "Its evolution family, by pointer.",
            "type": "object",
            "x-cc": {
              "ref": "pokemon-family"
            },
            "required": [
              "$kind",
              "id"
            ],
            "properties": {
              "$kind": {
                "description": "What the pointer points at: `pokemon-family`. index.json's `pointers` say where to find it (https://pokemon.cardcorpus.com/v1/docs/guide.md#pointers).",
                "const": "pokemon-family"
              },
              "id": {
                "description": "The evolution family's id (pokemon-families/{id}.json).",
                "type": "string"
              }
            }
          },
          "names": {
            "description": "Its name in other languages, by language code.",
            "type": "object",
            "additionalProperties": {
              "description": "The name.",
              "type": "string"
            }
          },
          "types": {
            "description": "Its default form's types.",
            "type": "array",
            "items": {
              "description": "A type.",
              "type": "string"
            }
          },
          "tagline": {
            "description": "Its one-line description.",
            "type": "string"
          },
          "forms": {
            "description": "Every form but the first, the default, with how many cards show it.",
            "type": "array",
            "items": {
              "type": "object",
              "x-cc": {
                "label": "name"
              },
              "required": [
                "id",
                "name",
                "generation"
              ],
              "properties": {
                "id": {
                  "description": "The form's id: the dex number, with \":<key>\" for a form other than the default (\"52\", \"52:galar\").",
                  "type": "string"
                },
                "name": {
                  "description": "The form's name.",
                  "type": "string"
                },
                "category": {
                  "description": "What kind of form it is, where it isn't the default.",
                  "enum": [
                    "regional",
                    "mega",
                    "primal",
                    "gigantamax",
                    "costume",
                    "cosmetic",
                    "alternate"
                  ]
                },
                "generation": {
                  "description": "The generation the form first appeared in.",
                  "type": "integer",
                  "minimum": 1
                },
                "cardCount": {
                  "description": "How many cards that show the form; always present, 0 included.",
                  "type": "integer",
                  "minimum": 0
                }
              }
            }
          },
          "cardCount": {
            "description": "How many cards that show it in any form but a regional one; always present, 0 included.",
            "type": "integer",
            "minimum": 0
          },
          "catalogs": {
            "description": "The catalogs with cards of it in any form, each with a file of them (pokemon-cards/{catalog}/{dex}.json); none where it has no cards.",
            "type": "array",
            "items": {
              "description": "A catalog.",
              "x-cc": {
                "vocabulary": "catalog"
              },
              "allOf": [
                {
                  "$ref": "#/$defs/vocabulary.catalog"
                }
              ]
            }
          },
          "totalCardCount": {
            "description": "How many cards that show it in any form, regional ones included, each card once; always present, 0 included.",
            "type": "integer",
            "minimum": 0
          },
          "pictures": {
            "description": "Its picture, a picture id: the official `artwork`.",
            "type": "object",
            "properties": {
              "artwork": {
                "description": "Its official artwork.",
                "type": "string",
                "pattern": "^[0-9a-f]{32}$",
                "x-cc": {
                  "picture": true
                }
              }
            },
            "additionalProperties": false
          }
        }
      }
    }
  },
  "$defs": {
    "vocabulary.catalog": {
      "title": "Catalog",
      "description": "Every value of vocabulary.json's `catalog`.",
      "type": "string",
      "enum": [
        "english",
        "japanese",
        "zh-hans",
        "korean",
        "zh-hant",
        "thai",
        "indonesian",
        "french",
        "german",
        "italian",
        "spanish",
        "portuguese",
        "latin-american-spanish",
        "dutch",
        "russian",
        "polish"
      ]
    }
  }
}
