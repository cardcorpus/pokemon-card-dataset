{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CardCorpus characters",
  "description": "Every character on the cards: a named person or group from the Pokémon world, not a Pokémon. A character is on a card as its subject (the Supporter card \"Misty\", or \"Here Comes Team Rocket!\") or as the owner of its Pokémon (\"Misty's Psyduck\"). Misty, Cynthia, N, Lillie and Team Rocket are characters. Each has a file of their cards per catalog, characters/{catalog}/{id}.json.",
  "type": "object",
  "required": [
    "characterCount",
    "characters"
  ],
  "properties": {
    "characterCount": {
      "description": "How many characters; always present, 0 included.",
      "type": "integer",
      "minimum": 0
    },
    "characters": {
      "description": "Every character, in id order.",
      "type": "array",
      "items": {
        "type": "object",
        "x-cc": {
          "label": "name",
          "record": "character"
        },
        "required": [
          "id",
          "name",
          "cardCount"
        ],
        "properties": {
          "id": {
            "description": "The character's id (characters.json).",
            "type": "string"
          },
          "name": {
            "description": "Their name in English: \"Misty\", \"Team Rocket\".",
            "type": "string"
          },
          "cardCount": {
            "description": "How many cards they're the subject of or own a Pokémon on, in every catalog; always present, 0 included.",
            "type": "integer",
            "minimum": 0
          },
          "catalogs": {
            "description": "The catalogs they have cards in, each with a file of them (characters/{catalog}/{id}.json); none where they have no cards.",
            "type": "array",
            "items": {
              "description": "A catalog.",
              "x-cc": {
                "vocabulary": "catalog"
              },
              "allOf": [
                {
                  "$ref": "#/$defs/vocabulary.catalog"
                }
              ]
            }
          }
        }
      }
    }
  },
  "$defs": {
    "vocabulary.catalog": {
      "title": "Catalog",
      "description": "Every value of vocabulary.json's `catalog`.",
      "type": "string",
      "enum": [
        "english",
        "japanese",
        "zh-hans",
        "korean",
        "zh-hant",
        "thai",
        "indonesian",
        "french",
        "german",
        "italian",
        "spanish",
        "portuguese",
        "latin-american-spanish",
        "dutch",
        "russian",
        "polish"
      ]
    }
  }
}
